{%- comment -%}
  Fernatto brand mark: a fern frond inside an arch.
  Usage: {% render 'brand-mark', size: 36, wordmark: true %}
{%- endcomment -%}
{%- assign s = size | default: 36 -%}
<span class="brand-mark">
  <svg class="brand-mark__icon" width="{{ s }}" height="{{ s }}" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M8 44V22a16 16 0 0 1 32 0v22"/>
    <path d="M24 42V14"/>
    <path d="M24 18c-3-1.5-6-1.5-8 0M24 18c3-1.5 6-1.5 8 0"/>
    <path d="M24 24c-4-2-8-2-10.5 0M24 24c4-2 8-2 10.5 0"/>
    <path d="M24 30c-4.5-2-9-2-11.5 .5M24 30c4.5-2 9-2 11.5 .5"/>
    <path d="M24 36c-4-1.6-7.5-1.6-9.5 .5M24 36c4-1.6 7.5-1.6 9.5 .5"/>
  </svg>
  {%- if wordmark -%}<span class="brand-mark__word">{{ shop.name | upcase }}</span>{%- endif -%}
</span>
