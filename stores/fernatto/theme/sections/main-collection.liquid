<section class="wrap section">
  <header class="page-head">
    <h1 class="page-head__title">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rte page-head__text">{{ collection.description }}</div>{%- endif -%}
  </header>

  {%- paginate collection.products by 24 -%}
    <div class="toolbar">
      <p class="muted">{{ 'collections.count' | t: count: collection.products_count }}</p>
      <label class="toolbar__sort">
        <span class="visually-hidden">{{ 'collections.sort' | t }}</span>
        <select data-sort>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>
    <div class="grid">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>{{ 'collections.empty' | t }}</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager" aria-label="{{ 'general.pagination' | t }}">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
