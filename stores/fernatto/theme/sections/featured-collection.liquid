{%- assign c = section.settings.collection -%}
<section class="section">
  <div class="wrap">
    <div class="section__head">
      <h2 class="section__title">{{ section.settings.title | default: c.title }}</h2>
      {%- if c != blank -%}<a class="link" href="{{ c.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
    </div>
    <div class="grid">
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div></article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
