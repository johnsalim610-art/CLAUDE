<section class="wrap section narrow">
  <header class="page-head"><h1 class="page-head__title">{{ 'cart.title' | t }}</h1></header>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" class="cart">
      <ul class="cart__items">
        {%- for item in cart.items -%}
          <li class="cart__item">
            <a class="cart__img" href="{{ item.url }}">
              {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{%- endif -%}
            </a>
            <div class="cart__meta">
              <a href="{{ item.url }}" class="cart__title">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}<p class="muted">{{ item.variant.title }}</p>{%- endunless -%}
              <p>{{ item.final_price | money }}</p>
              <label class="visually-hidden" for="q-{{ item.key }}">{{ 'products.quantity' | t }}</label>
              <input id="q-{{ item.key }}" class="cart__qty" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
              <a class="link muted" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
            </div>
            <p class="cart__line">{{ item.final_line_price | money }}</p>
          </li>
        {%- endfor -%}
      </ul>
      <div class="cart__summary">
        <p class="cart__total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money_with_currency }}</strong></p>
        <p class="muted">{{ 'cart.taxes_shipping' | t }}</p>
        <div class="cart__actions">
          <button type="submit" name="update" class="btn btn--ghost">{{ 'cart.update' | t }}</button>
          <button type="submit" name="checkout" class="btn">{{ 'cart.checkout' | t }}</button>
        </div>
        {%- if additional_checkout_buttons -%}<div class="cart__extra">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
      </div>
    </form>
  {%- else -%}
    <p class="center">{{ 'cart.empty' | t }}</p>
    <p class="center"><a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a></p>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
