<section class="wrap section">
  <header class="page-head"><h1 class="page-head__title">{{ 'search.title' | t }}</h1></header>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search">
    <label class="visually-hidden" for="q">{{ 'general.search' | t }}</label>
    <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="btn" type="submit">{{ 'general.search' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="muted">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
      <div class="grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <article class="card"><a class="card__link" href="{{ item.url }}"><div class="card__body"><h3 class="card__title">{{ item.title }}</h3></div></a></article>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pager">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
