<section class="wrap section narrow">
  <header class="page-head"><h1 class="page-head__title">{{ page.title }}</h1></header>
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
  {%- form 'contact', class: 'form' -%}
    {%- if form.posted_successfully? -%}
      <p class="notice" role="status">{{ 'contact.success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="c-name">{{ 'contact.name' | t }}</label><input id="c-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
    <div class="field"><label for="c-email">{{ 'contact.email' | t }} *</label><input id="c-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
    <div class="field"><label for="c-order">{{ 'contact.order' | t }}</label><input id="c-order" type="text" name="contact[order]"></div>
    <div class="field"><label for="c-msg">{{ 'contact.message' | t }}</label><textarea id="c-msg" name="contact[body]" rows="6">{{ form.body }}</textarea></div>
    <button type="submit" class="btn">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{ "name": "Contact form", "settings": [] }
{% endschema %}
