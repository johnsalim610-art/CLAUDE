{% layout 'password' %}
<section class="wrap section narrow center">
  {% render 'brand-mark', size: 56, wordmark: true %}
  <h1 class="page-head__title">{{ 'password.title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', class: 'form' -%}
    {%- if form.errors -%}<div class="notice notice--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="field"><label for="pw">{{ 'password.label' | t }}</label><input id="pw" type="password" name="password" autocomplete="current-password"></div>
    <button type="submit" class="btn">{{ 'password.enter' | t }}</button>
  {%- endform -%}
</section>
