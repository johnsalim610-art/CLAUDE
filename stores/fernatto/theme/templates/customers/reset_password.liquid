<section class="wrap section narrow">
  <h1 class="page-head__title">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <div class="field"><label for="rp">{{ 'password.label' | t }}</label><input id="rp" type="password" name="customer[password]" autocomplete="new-password"></div>
    <div class="field"><label for="rpc">{{ 'customer.password_confirm' | t }}</label><input id="rpc" type="password" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <button class="btn" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</section>
