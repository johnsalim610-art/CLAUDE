<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  {%- comment -%} google-site-verification:start {%- endcomment -%}
  {%- comment -%} google-site-verification:end {%- endcomment -%}
  <title>{{ shop.name }}</title>
  {%- assign heading_font = settings.type_heading_font -%}{%- assign body_font = settings.type_body_font -%}
  <style>
    {{ heading_font | font_face: font_display: 'swap' }}{{ body_font | font_face: font_display: 'swap' }}
    :root{--c-bg:{{ settings.color_background }};--c-surface:{{ settings.color_surface }};--c-ink:{{ settings.color_text }};--c-muted:{{ settings.color_muted }};--c-brand:{{ settings.color_brand }};--c-on-brand:{{ settings.color_on_brand }};--c-accent:{{ settings.color_accent }};--c-line:{{ settings.color_line }};--f-head:{{ heading_font.family }},{{ heading_font.fallback_families }};--f-head-w:{{ heading_font.weight }};--f-body:{{ body_font.family }},{{ body_font.fallback_families }};--f-body-w:{{ body_font.weight }};--radius:6px;--page:1280px}
  </style>
  {{ 'fernatto.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body><main id="main">{{ content_for_layout }}</main></body>
</html>
